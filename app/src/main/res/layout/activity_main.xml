<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_season_registration"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/label_season" />

        <EditText
            android:id="@+id/editTextTemporada"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_season"
            android:inputType="text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_club" />

        <EditText
            android:id="@+id/editTextClube"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_club"
            android:inputType="text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_matches" />

        <EditText
            android:id="@+id/editTextPartidas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_matches"
            android:inputType="number" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_goals" />

        <EditText
            android:id="@+id/editTextGols"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_goals"
            android:inputType="number" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_assists" />

        <EditText
            android:id="@+id/editTextAssistencias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_assists"
            android:inputType="number" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/label_season_status" />

        <RadioGroup
            android:id="@+id/radioGroupStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/radioButtonAndamento"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_in_progress" />

            <RadioButton
                android:id="@+id/radioButtonFinalizada"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_finished" />

        </RadioGroup>

        <CheckBox
            android:id="@+id/checkBoxTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_won_title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_player_position" />

        <Spinner
            android:id="@+id/spinnerPosicao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>

</ScrollView>

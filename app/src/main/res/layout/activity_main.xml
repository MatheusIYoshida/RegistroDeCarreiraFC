<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cadastro de Temporada"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Temporada" />

        <EditText
            android:id="@+id/editTextTemporada"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ex: 2026/2027"
            android:inputType="text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Clube" />

        <EditText
            android:id="@+id/editTextClube"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ex: Real Madrid"
            android:inputType="text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Partidas" />

        <EditText
            android:id="@+id/editTextPartidas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ex: 38"
            android:inputType="number" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Gols" />

        <EditText
            android:id="@+id/editTextGols"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ex: 25"
            android:inputType="number" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Assistências" />

        <EditText
            android:id="@+id/editTextAssistencias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ex: 12"
            android:inputType="number" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Status da temporada" />

        <RadioGroup
            android:id="@+id/radioGroupStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/radioButtonAndamento"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Em andamento" />

            <RadioButton
                android:id="@+id/radioButtonFinalizada"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Finalizada" />

        </RadioGroup>

        <CheckBox
            android:id="@+id/checkBoxTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Conquistou título nesta temporada" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Posição do jogador" />

        <Spinner
            android:id="@+id/spinnerPosicao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/buttonLimpar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Limpar" />

        <Button
            android:id="@+id/buttonSalvar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Salvar" />

    </LinearLayout>

</ScrollView>